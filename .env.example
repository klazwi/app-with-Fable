# Copy this file to .env and fill in what you need. The .env file is not committed.

# Where the app is published. 127.0.0.1 = this computer only.
SLOWO_BIND=127.0.0.1
SLOWO_PORT=8000

# Login that gets the admin panel. Register it first. Empty = the very first account.
SLOWO_ADMIN=

# Host names the app answers to, comma-separated (for example slowo.example.com). Empty = any.
SLOWO_HOSTS=

# Behind a reverse proxy with HTTPS set both to 1.
SLOWO_SECURE=0
TRUST_PROXY=0

# Mail server for verification codes. Without SMTP_HOST the codes are printed to the container log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
